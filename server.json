{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pictify-io/mcp",
  "description": "Generate images, GIFs, and PDFs from HTML, URLs, or templates — from your AI agent.",
  "websiteUrl": "https://pictify.io",
  "repository": {
    "url": "https://github.com/pictify-io/mcp",
    "source": "github"
  },
  "version": "1.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@pictify/mcp-server",
      "version": "1.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PICTIFY_API_KEY",
          "description": "Your Pictify API key from https://pictify.io/dashboard/api-tokens",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.pictify.io"
    }
  ]
}
